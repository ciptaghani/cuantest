# PostgreSQL. Contoh Supabase:
# - DATABASE_URL: pooler mode transaksi (port 6543) + pgbouncer=true → dipakai aplikasi
# - DIRECT_URL:   session pooler / koneksi langsung (port 5432) → dipakai prisma migrate
# Parameter schema=... menentukan schema Postgres (default "public").
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
AUTH_SECRET=""
UPLOAD_DIR="./uploads"
APP_URL="http://localhost:3000"

# Dipakai sekali oleh `npm run db:seed` untuk membuat admin pertama.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""
