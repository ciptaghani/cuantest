// Skema database Cuan Lens.
// Nama tabel/kolom bahasa Inggris, label UI tetap bahasa Indonesia.
// Uang: Decimal(15,2). Tanggal bisnis (tanpa jam): @db.Date.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Aplikasi: pooler mode transaksi (Supabase :6543, ?pgbouncer=true).
  url       = env("DATABASE_URL")
  // Migrasi: koneksi session/direct (Supabase :5432), karena pgbouncer mode transaksi tidak mendukung migrasi.
  directUrl = env("DIRECT_URL")
}

// ============================================================
// AKSES
// ============================================================

enum Role {
  ADMIN
  STAFF
}

enum Menu {
  MARKETPLACE
  MARKETING
  OPS
  FINANCE
  CS
  DATA
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  permissions UserPermission[]
  sessions    Session[]

  stockMovements StockMovement[]
  opnames        Opname[]
  opnameCounts   OpnameCount[]
  returnNotes    ReturnNote[]
  adChangeLogs   AdChangeLog[]
  marketingPlans MarketingPlan[]
  purchaseOrders PurchaseOrder[]
  invoices       PurchaseInvoice[]
  payments       Payment[]
  transfers      Transfer[]
  attendances    Attendance[]
}

model UserPermission {
  userId String
  menu   Menu
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, menu])
}

// Session database. sessionToken berisi SHA-256 dari token di cookie (token asli tidak disimpan).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Rate limit percobaan login. key = "ip:<alamat>" atau "user:<username>".
model LoginAttempt {
  key         String    @id @db.VarChar(191)
  failures    Int       @default(0)
  windowStart DateTime
  lockedUntil DateTime?
}

// ============================================================
// MASTER
// ============================================================

model Warehouse {
  id        String  @id @default(cuid())
  code      String  @unique // jogja | sini | rembang (id lama di HTML)
  name      String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  movementsFrom StockMovement[]   @relation("MovementFrom")
  movementsTo   StockMovement[]   @relation("MovementTo")
  opnames       Opname[]
  invoices      PurchaseInvoice[]
  mainFor       AppConfig[]       @relation("MainWarehouse")
  salesFor      AppConfig[]       @relation("SalesWarehouse")
}

// Brand produk (HMNS, Mykonos, ...), bukan brand toko.
model Brand {
  id           String @id @default(cuid())
  name         String @unique
  leadTimeDays Int? // 99 = kebijakan brand (tanpa buffer lead time)

  skus            Sku[]
  conversionRules ConversionRule[]
  sourceOverrides SourceOverride[]
  productInfos    ProductInfo[]
}

// Kategori (Fullsize/Decant/Lainnya) tidak disimpan: dihitung dari ConversionRule.
model Sku {
  id         String   @id @default(cuid())
  code       String   @unique
  brandId    String
  productKey String // nama produk; brand + productKey = satu varian
  variant    String   @default("")
  ml         Decimal  @default(0) @db.Decimal(10, 2)
  price      Decimal  @default(0) @db.Decimal(15, 2)
  cogs       Decimal  @default(0) @db.Decimal(15, 2) // HPP master
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id])

  sourceFor          SourceOverride[]
  movementSources    StockMovement[]
  movementLines      StockMovementLine[]
  dailySales         DailySale[]
  opnameCounts       OpnameCount[]
  returnNotes        ReturnNote[]
  historyAvg         HistoryAvg?
  purchaseOrderLines PurchaseOrderLine[]
  invoiceLines       PurchaseInvoiceLine[]

  @@index([brandId, productKey])
}

model Pack {
  id      String  @id @default(cuid())
  name    String
  bottle  Decimal @default(0) @db.Decimal(15, 2)
  sticker Decimal @default(0) @db.Decimal(15, 2)
  other   Decimal @default(0) @db.Decimal(15, 2)

  rules ConversionRule[]
}

model ConversionRule {
  id           String  @id @default(cuid())
  brandId      String
  fromMl       Decimal @db.Decimal(10, 2)
  toMl         Decimal @db.Decimal(10, 2)
  qtyPerBottle Decimal @db.Decimal(10, 2)
  packId       String?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  pack  Pack? @relation(fields: [packId], references: [id], onDelete: SetNull)

  @@unique([brandId, fromMl, toMl])
}

// Override sumber fullsize untuk decant (default: fullsize terbesar dgn brand+produk sama).
model SourceOverride {
  id         String @id @default(cuid())
  brandId    String
  productKey String
  skuId      String

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  sku   Sku   @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([brandId, productKey])
}

enum AvgMode {
  HISTORY // histori penjualan (dari Excel)
  LOG // penjualan terbaru dari export pesanan
  MAX // ambil yang lebih tinggi
}

// Satu baris saja (id = 1).
model AppConfig {
  id               Int       @id @default(1)
  shrinkPct        Decimal   @default(95) @db.Decimal(5, 2) // susut decant (yieldPct di HTML)
  targetDays       Int       @default(14) // minDays di HTML
  avgMode          AvgMode   @default(HISTORY)
  avgDays          Int       @default(30)
  mainWarehouseId  String?
  salesWarehouseId String? // gudang pengiriman marketplace
  targetMargin     Decimal   @default(12) @db.Decimal(5, 2) // % margin bersih
  financeStartDate DateTime? @db.Date // tanggal mulai pembukuan
  historyLabel     String?
  updatedAt        DateTime  @updatedAt

  mainWarehouse  Warehouse? @relation("MainWarehouse", fields: [mainWarehouseId], references: [id], onDelete: SetNull)
  salesWarehouse Warehouse? @relation("SalesWarehouse", fields: [salesWarehouseId], references: [id], onDelete: SetNull)
}

// ============================================================
// MARKETPLACE
// ============================================================

enum Channel {
  SHOPEE
  TIKTOK
}

model Store {
  id      String  @id @default(cuid())
  name    String
  channel Channel
  brand   String // brand toko: ngado.kado | giveme.id | smolify.id
  isDemo  Boolean @default(false)

  // Tarif cadangan (persen kecuali feeProcess dalam Rupiah per pesanan)
  feeAdmin    Decimal @default(8) @db.Decimal(6, 3)
  feeFreeShip Decimal @default(0) @db.Decimal(6, 3)
  feeService  Decimal @default(0) @db.Decimal(6, 3)
  feeTax      Decimal @default(0.5) @db.Decimal(6, 3)
  feeAms      Decimal @default(0) @db.Decimal(6, 3)
  feeProcess  Decimal @default(1250) @db.Decimal(15, 2)

  walletAccountId String?  @unique // akun "Saldo <toko>" di buku besar
  createdAt       DateTime @default(now())

  walletAccount  Account?        @relation("StoreWallet", fields: [walletAccountId], references: [id], onDelete: SetNull)
  catalogs       Catalog[]
  orders         Order[]
  orderFees      OrderFee[]
  adRecords      AdRecord[]
  adCatalogMaps  AdCatalogMap[]
  adChangeLogs   AdChangeLog[]
  marketingPlans MarketingPlan[]
  payments       Payment[]
}

model Catalog {
  id          String @id @default(cuid())
  storeId     String
  externalKey String // id produk/listing di marketplace
  name        String @db.VarChar(500)

  store      Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  lines      OrderLine[]
  adRecords  AdRecord[]
  adMaps     AdCatalogMap[]
  changeLogs AdChangeLog[]

  @@unique([storeId, externalKey])
}

model Order {
  id        String   @id @default(cuid())
  storeId   String
  orderNo   String
  createdAt DateTime // waktu pesanan dibuat (dari export)

  store Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  lines OrderLine[]

  @@unique([storeId, orderNo])
  @@index([storeId, createdAt])
  @@index([createdAt])
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  catalogId String?
  skuCode   String // kode SKU apa adanya dari export (bisa belum ada di master)
  variation String  @default("")
  qty       Int
  subtotal  Decimal @db.Decimal(15, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalog Catalog? @relation(fields: [catalogId], references: [id], onDelete: SetNull)

  @@index([skuCode])
  @@index([catalogId])
}

// Dari laporan Penghasilan/settlement. Ada baris = pesanan sudah tersettle.
// Dikunci per (toko, no. pesanan), bukan FK ke Order: laporan penghasilan boleh diupload
// sebelum export pesanan (sama seperti versi HTML).
model OrderFee {
  storeId   String
  orderNo   String
  admin    Decimal   @default(0) @db.Decimal(15, 2)
  process   Decimal   @default(0) @db.Decimal(15, 2)
  freeShip  Decimal   @default(0) @db.Decimal(15, 2)
  service   Decimal   @default(0) @db.Decimal(15, 2)
  tax       Decimal   @default(0) @db.Decimal(15, 2)
  other     Decimal   @default(0) @db.Decimal(15, 2)
  ams       Decimal   @default(0) @db.Decimal(15, 2) // affiliate
  total     Decimal   @default(0) @db.Decimal(15, 2) // total penghasilan (nilai settlement)
  settledAt DateTime? @db.Date // "Tanggal dana dilepaskan"

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, orderNo])
  @@index([settledAt])
}

model AdRecord {
  id        String   @id @default(cuid())
  storeId   String
  dateFrom  DateTime @db.Date
  dateTo    DateTime @db.Date
  adName    String   @db.VarChar(500)
  catalogId String?
  amount    Decimal  @default(0) @db.Decimal(15, 2) // biaya iklan
  sales     Decimal  @default(0) @db.Decimal(15, 2) // omzet dari iklan

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  catalog Catalog? @relation(fields: [catalogId], references: [id], onDelete: SetNull)

  @@index([storeId, dateFrom, dateTo])
  @@index([catalogId])
}

// Pencocokan nama iklan → katalog (otomatis atau koreksi manual).
model AdCatalogMap {
  id        String  @id @default(cuid())
  storeId   String
  adName    String  @db.VarChar(500)
  catalogId String?
  manual    Boolean @default(false)

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  catalog Catalog? @relation(fields: [catalogId], references: [id], onDelete: SetNull)

  @@unique([storeId, adName])
}

// ============================================================
// OPERASIONAL
// ============================================================

enum MovementType {
  PRODUCTION // produksi decant
  SHIFT // geser decant
  IN // barang masuk / restock
  OUT // barang keluar
  TRANSFER // pindah gudang
}

model StockMovement {
  id            String       @id @default(cuid())
  type          MovementType
  date          DateTime     @db.Date
  warehouseId   String
  toWarehouseId String? // hanya TRANSFER
  sourceSkuId   String? // botol sumber (PRODUCTION/SHIFT)
  sourceQty     Decimal?     @db.Decimal(12, 3) // jumlah botol sumber terpakai
  reason        String?
  note          String?      @db.Text
  invoiceId     String? // dibuat otomatis dari faktur pembelian SKU
  createdById   String?
  createdAt     DateTime     @default(now())

  warehouse   Warehouse           @relation("MovementFrom", fields: [warehouseId], references: [id])
  toWarehouse Warehouse?          @relation("MovementTo", fields: [toWarehouseId], references: [id])
  sourceSku   Sku?                @relation(fields: [sourceSkuId], references: [id])
  invoice     PurchaseInvoice?    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy   User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines       StockMovementLine[]

  @@index([date])
  @@index([warehouseId, date])
  @@index([toWarehouseId, date])
  @@index([invoiceId])
}

model StockMovementLine {
  id         String   @id @default(cuid())
  movementId String
  skuId      String
  qty        Int
  unitPrice  Decimal? @db.Decimal(15, 2) // harga beli per pcs (IN)

  movement StockMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  sku      Sku           @relation(fields: [skuId], references: [id])

  @@index([skuId])
}

// Dibangkitkan dari OrderLine (toko non-demo), bukan diinput manual.
model DailySale {
  id     String   @id @default(cuid())
  date   DateTime @db.Date
  skuId  String
  qty    Int
  source String   @default("Export pesanan")

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([date, skuId, source])
  @@index([skuId, date])
}

model Opname {
  id          String    @id @default(cuid())
  date        DateTime  @db.Date
  warehouseId String
  final       Boolean   @default(false)
  finalizedAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id])
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  counts    OpnameCount[]

  @@unique([warehouseId, date])
  @@index([date])
}

// Satu baris per SKU, supaya input bersamaan tidak saling menimpa.
model OpnameCount {
  id          String   @id @default(cuid())
  opnameId    String
  skuId       String
  qty         Int? // null = belum dihitung
  countedById String?
  updatedAt   DateTime @updatedAt

  opname    Opname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  sku       Sku    @relation(fields: [skuId], references: [id])
  countedBy User?  @relation(fields: [countedById], references: [id], onDelete: SetNull)

  @@unique([opnameId, skuId])
  @@index([skuId])
}

// Retur hanya catatan: tidak memengaruhi stok, HPP, maupun keuangan.
model ReturnNote {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  code        String // hasil scan barcode / no. resi / no. pesanan
  skuId       String?
  skuCode     String?
  qty         Int      @default(1)
  matches     Boolean  @default(true) // kondisi barang: Sesuai / Tidak sesuai
  processed   Boolean  @default(false) // sudah diproses di Desty
  note        String?  @db.Text
  createdById String?
  createdAt   DateTime @default(now())

  sku       Sku?  @relation(fields: [skuId], references: [id], onDelete: SetNull)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([code])
}

model Employee {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)

  attendances Attendance[]
}

model Attendance {
  id          String   @id @default(cuid())
  employeeId  String
  date        DateTime @db.Date
  present     Boolean  @default(false)
  note        String?
  updatedById String?
  updatedAt   DateTime @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  updatedBy User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date])
}

// Rata-rata jual harian dari histori (upload Excel).
model HistoryAvg {
  skuId    String  @id
  avgDaily Decimal @db.Decimal(12, 4)
  label    String?

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)
}

// ============================================================
// CS
// ============================================================

model ProductInfo {
  id         String    @id @default(cuid())
  brandId    String
  productKey String
  expiredAt  DateTime? @db.Date
  notes      String?   @db.Text
  lookUrl    String?   @db.VarChar(1000)
  updatedAt  DateTime  @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, productKey])
}

// ============================================================
// MARKETING
// ============================================================

model AdChangeLog {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  storeId     String?
  catalogId   String?
  type        String // Budget harian | Target ROAS | Status iklan (on/off) | ...
  fromValue   String?
  toValue     String?
  note        String?  @db.Text
  createdById String?
  createdAt   DateTime @default(now())

  store     Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  catalog   Catalog? @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([storeId, date])
}

model MarketingPlan {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  title       String
  category    String
  storeId     String?
  note        String?  @db.Text
  done        Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())

  store     Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([storeId, date])
}

// ============================================================
// FINANCE
// ============================================================

enum AccountType {
  ASSET // aset
  LIABILITY // kewajiban
  EQUITY // modal
  REVENUE // pendapatan
  COGS // hpp
  EXPENSE // beban
  OTHER_INCOME // pendapatan_lain
  OTHER_EXPENSE // beban_lain
}

model Account {
  id       String      @id @default(cuid())
  code     String      @unique
  name     String
  type     AccountType
  group    String?
  isCash   Boolean     @default(false)
  isInvest Boolean     @default(false)
  isSystem Boolean     @default(false) // dari DEF_COA, tidak boleh dihapus
  active   Boolean     @default(true)

  bankAccount    BankAccount?
  storeWallet    Store?                @relation("StoreWallet")
  openingBalance OpeningBalance?
  invoiceLines   PurchaseInvoiceLine[]
  paymentLines   PaymentLine[]
  payments       Payment[]
  transfersFrom  Transfer[]            @relation("TransferFrom")
  transfersTo    Transfer[]            @relation("TransferTo")
}

model BankAccount {
  id        String  @id @default(cuid())
  name      String
  number    String?
  accountId String  @unique
  active    Boolean @default(true)

  account  Account   @relation(fields: [accountId], references: [id])
  payments Payment[]
}

model OpeningBalance {
  accountId String  @id
  amount    Decimal @db.Decimal(15, 2)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Supplier {
  id    String  @id @default(cuid())
  name  String  @unique
  phone String?
  note  String? @db.Text

  purchaseOrders PurchaseOrder[]
  invoices       PurchaseInvoice[]
}

enum PurchaseOrderStatus {
  OPEN
  INVOICED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  number      String              @unique
  date        DateTime            @db.Date
  supplierId  String?
  status      PurchaseOrderStatus @default(OPEN)
  discIsPct   Boolean             @default(false)
  discValue   Decimal             @default(0) @db.Decimal(15, 2)
  extra       Decimal             @default(0) @db.Decimal(15, 2) // ongkir/biaya lain
  note        String?             @db.Text
  createdById String?
  createdAt   DateTime            @default(now())

  supplier  Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines     PurchaseOrderLine[]
  invoices  PurchaseInvoice[]

  @@index([date])
}

model PurchaseOrderLine {
  id    String  @id @default(cuid())
  poId  String
  skuId String?
  name  String
  qty   Decimal @db.Decimal(12, 3)
  unit  String  @default("pcs")
  price Decimal @db.Decimal(15, 2)
  disc  Decimal @default(0) @db.Decimal(15, 2)

  po  PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  sku Sku?          @relation(fields: [skuId], references: [id], onDelete: SetNull)
}

model PurchaseInvoice {
  id                  String    @id @default(cuid())
  number              String    @unique
  date                DateTime  @db.Date
  dueDate             DateTime? @db.Date
  supplierId          String?
  poId                String?
  receivedWarehouseId String? // gudang penerimaan untuk baris SKU
  received            Boolean   @default(true) // barang sudah diterima → buat StockMovement IN
  discIsPct          Boolean   @default(false)
  discValue           Decimal   @default(0) @db.Decimal(15, 2)
  extra               Decimal   @default(0) @db.Decimal(15, 2) // ongkir, dibagi proporsional ke harga per pcs
  note                String?   @db.Text
  createdById         String?
  createdAt           DateTime  @default(now())

  supplier          Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  po                PurchaseOrder?        @relation(fields: [poId], references: [id], onDelete: SetNull)
  receivedWarehouse Warehouse?            @relation(fields: [receivedWarehouseId], references: [id], onDelete: SetNull)
  createdBy         User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines             PurchaseInvoiceLine[]
  stockMovements    StockMovement[]
  payments          Payment[]

  @@index([date])
  @@index([supplierId])
}

enum InvoiceLineKind {
  SKU
  OTHER
}

model PurchaseInvoiceLine {
  id        String          @id @default(cuid())
  invoiceId String
  kind      InvoiceLineKind
  skuId     String? // kind = SKU
  accountId String? // kind = OTHER
  name      String
  qty       Decimal         @db.Decimal(12, 3)
  unit      String          @default("pcs")
  price     Decimal         @db.Decimal(15, 2)
  disc      Decimal         @default(0) @db.Decimal(15, 2)

  invoice PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sku     Sku?            @relation(fields: [skuId], references: [id], onDelete: SetNull)
  account Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
}

enum PaymentKind {
  EXPENSE // beban (multi baris)
  INVOICE // pembayaran faktur
  ADS_TOPUP // top up saldo iklan (satu-satunya sumber beban iklan)
  RECEIPT // penerimaan lain
  EXPENSE_REMAINDER // bayar sisa beban
}

model Payment {
  id            String      @id @default(cuid())
  number        String      @unique // mis. BY/202610/001
  kind          PaymentKind
  date          DateTime    @db.Date
  bankAccountId String? // sumber/tujuan dana
  amount        Decimal     @db.Decimal(15, 2) // nilai yang dibayar sekarang (lunas/DP)
  invoiceId     String? // INVOICE
  refPaymentId  String? // EXPENSE_REMAINDER → EXPENSE induk
  storeId       String? // ADS_TOPUP
  accountId     String? // ADS_TOPUP: akun beban iklan; RECEIPT: akun pendapatan
  proofPath     String? // path relatif di UPLOAD_DIR
  note          String?     @db.Text
  createdById   String?
  createdAt     DateTime    @default(now())

  bankAccount BankAccount?     @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  invoice     PurchaseInvoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  refPayment  Payment?         @relation("Remainder", fields: [refPaymentId], references: [id], onDelete: Restrict)
  remainders  Payment[]        @relation("Remainder")
  store       Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)
  account     Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines       PaymentLine[]

  @@index([date])
  @@index([kind, date])
  @@index([invoiceId])
  @@index([storeId, date])
}

// Rincian beban (EXPENSE): total baris bisa > amount (sisanya dibayar lewat EXPENSE_REMAINDER).
model PaymentLine {
  id        String  @id @default(cuid())
  paymentId String
  accountId String
  amount    Decimal @db.Decimal(15, 2)
  note      String?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])
}

// Pemindahan dana, mis. saldo marketplace → rekening.
model Transfer {
  id            String   @id @default(cuid())
  number        String   @unique
  date          DateTime @db.Date
  fromAccountId String
  toAccountId   String
  amount        Decimal  @db.Decimal(15, 2)
  fee           Decimal  @default(0) @db.Decimal(15, 2) // biaya penarikan
  note          String?  @db.Text
  createdById   String?
  createdAt     DateTime @default(now())

  fromAccount Account @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccount   Account @relation("TransferTo", fields: [toAccountId], references: [id])
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date])
}
